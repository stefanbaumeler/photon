{
    "name": "Photon App Schema",
    "schemaPath": "./src/api/schema.graphql",
    "includes": [
        "client-schema-extension.js",
        "*.graphql",
        "*.gql"
    ],
    "extensions": {
        "endpoints": {
            "Default GraphQL Endpoint": {
                "url": "https://localhost:2001/graphql",
                "headers": {
                    "user-agent": "JS GraphQL"
                },
                "introspect": true
            }
        }
    }
}
