{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "isolatedModules": true,
        "noEmitOnError": false,
        "declaration": true,
        "experimentalDecorators": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
