generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Album {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String?       @db.VarChar(100)
  description String?
  idCover     String?       @map("id_cover") @db.Uuid
  idOwner     String?       @map("id_owner") @db.Uuid
  cover       Medium?       @relation(fields: [idCover], references: [id], onUpdate: NoAction, map: "album_id_medium_foreign")
  owner       User?         @relation(fields: [idOwner], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "album_owner_foreign")
  albumMedia  AlbumMedium[]
}

model AlbumMedium {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idAlbum  String @map("id_album") @db.Uuid
  idMedium String @map("id_medium") @db.Uuid
  album    Album  @relation(fields: [idAlbum], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "album_medium_id_album_foreign")
  medium   Medium @relation(fields: [idMedium], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "album_medium_id_medium_foreign")

  @@unique([idAlbum, idMedium])
}

model Medium {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hash               String?       @db.VarChar(255)
  dateCreated        DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified       DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  dateModifiedStatus DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified_status") @db.Timestamptz(6)
  dateTaken          DateTime?     @map("date_taken") @db.Timestamptz(6)
  filenameDisk       String?       @map("filename_disk") @db.VarChar(100)
  filenameDownload   String?       @map("filename_download") @db.VarChar(100)
  title              String?       @db.VarChar(100)
  description        String?
  lat                Float?        @db.Real
  lng                Float?        @db.Real
  status             String?       @default("all")
  mimetype           String?       @db.VarChar(255)
  meta               Json?         @db.Json
  idOwner            String?       @db.Uuid
  owner              User?         @relation("medium_owner", fields: [idOwner], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medium_owner_foreign")
  idUploader         String?       @db.Uuid
  uploader           User?         @relation("medium_uploader", fields: [idUploader], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medium_uploader_foreign")
  albums             Album[]
  albumMedia         AlbumMedium[]
  favoredBy          User[]
}

model Device {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateCreated  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  users        User[]
  name         String
  type         String
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateCreated   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  mail          String   @db.VarChar(255)
  password      String   @db.VarChar(255)
  firstName     String   @map("first_name") @db.VarChar(255)
  lastName      String   @map("last_name") @db.VarChar(255)
  albums        Album[]
  media         Medium[] @relation("medium_owner")
  uploadedMedia Medium[] @relation("medium_uploader")
  devices       Device[]
  favorites     Medium[]
}
