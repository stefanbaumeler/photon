{
    "name": "@photon/api",
    "version": "1.0.0",
    "main": "index.ts",
    "license": "MIT",
    "scripts": {
        "build": "tsc -b ./tsconfig.json",
        "watch": "run-p -l watch:*",
        "watch:ts": "tsc -b ./tsconfig.json -w",
        "watch:api": "ts-node-dev dist",
        "watch:api-schema": "graphql-codegen -r dotenv/config -c codegen.yml -w",
        "db:seed": "yarn db:push && npx ts-node src/database/seeds",
        "db:truncate": "ts-node src/database/truncate.ts",
        "db:push": "prisma db push",
        "db:generate": "prisma generate",
        "start": "yarn db:push & node dist"
    },
    "dependencies": {
        "@ffmpeg/core": "^0.11.0",
        "@ffmpeg/ffmpeg": "^0.11.6",
        "@prisma/client": "4.7.1",
        "apollo-datasource-rest": "^3.6.1",
        "apollo-server-express": "^3.10.0",
        "argon2": "^0.30.2",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.0.3",
        "exifreader": "^4.5.1",
        "express": "^4.18.1",
        "graphql": "*",
        "graphql-date-scalars": "^0.2.0",
        "graphql-tag": "^2.12.6",
        "graphql-upload": "^13.0.0",
        "jsonwebtoken": "^8.5.1",
        "jszip": "^3.10.1",
        "mediainfo.js": "^0.1.8",
        "pg": "^8.7.3",
        "prisma": "^4.7.1",
        "sharp": "^0.31.1"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^2.6.2",
        "@graphql-codegen/typescript-react-apollo": "^3.2.16",
        "@graphql-codegen/typescript-resolvers": "^2.6.6",
        "@types/cookie-parser": "^1.4.3",
        "@types/express": "^4.17.13",
        "@types/ffmpeg": "^1.0.4",
        "@types/graphql-upload": "^8.0.12",
        "@types/multer": "^1.4.7",
        "@types/node": "^18.6.3",
        "@types/sharp": "^0.30.5",
        "npm-run-all": "^4.1.5",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^4.7.4"
    }
}
