{
  "compilerOptions": {
    "baseUrl": "./",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node",
      "jest",
      "@testing-library/jest-dom"
    ],
    "isolatedModules": false,
    "paths": {
      "@/*": [
        "web/*",
        "web/src/*"
      ]
    }
  },
  "include": [
    "web/*",
    "api/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
