{
    "compilerOptions": {
        "baseUrl": ".",
        "noImplicitAny": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "jsx": "preserve",
        "noEmit": true,
        "types": ["cypress", "node"],
        "isolatedModules": false,

    },
    "include": [
        "node_modules/cypress",
        "./cypress/**/*.ts",
    ],
    "exclude": [
        "node_modules"
    ],
    "files": [
        "./*.**.ts",
        "./*.**.tsx"
    ]
}
