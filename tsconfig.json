{
    "compilerOptions": {
        "baseUrl": "./",
        "noImplicitAny": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "noEmit": true,
        "types": ["node", "jest"],
        "isolatedModules": false,
        "paths": {
            "@/*": ["src/app/*", "src/app/src/*"]
        }
    },
    "include": [
        "node_modules/cypress",
        "./tests/**/*.ts",
        "src/app/*",
        "src/api/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
