{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@/*": [
                "app/*",
                "app/src/*"
            ]
        },
        "target": "es2016",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "noImplicitAny": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "incremental": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve"
    },
    "include": [
        "app/next-env.d.ts",
        "app/**/*.ts",
        "app/**/*.tsx",
        "app/**.*.css"
    ],
    "exclude": [
        "src-tauri",
        "node_modules"
    ]
}
