{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "*",
                "src/*"
            ]
        },
        "target": "es5",
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "noImplicitAny": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "incremental": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve"
    },
    "include": [
        ".",
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**.*.css"
    ],
    "exclude": [
        "node_modules"
    ]
}
