{
    "name": "photon",
    "private": true,
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "workspaces": [
        "app",
        "api",
        "packages/*"
    ],
    "engines": {
        "node": "^18.12.1"
    },
    "engineStrict": true,
    "scripts": {
        "dev": "NODE_ENV=development run-s start:docker watch",
        "prod:api": "run-s start:docker watch:api",
        "watch": "run-p watch:*",
        "watch:api": "yarn workspace @photon/api watch",
        "watch:app": "yarn workspace @photon/app watch",
        "watch:schema": "run-p schema:*",
        "schema:generate": "graphql-codegen -c codegen.ts -w",
        "schema:compile": "yarn workspace @photon/schema build",
        "start": "run-p start:api start:app",
        "start:api": "yarn workspace @photon/api start",
        "start:app": "yarn workspace @photon/app start",
        "start:docker": "docker-compose up -d db",
        "db:up": "yarn workspace @photon/api db:up",
        "db:down": "yarn workspace @photon/api db:down",
        "db:seed": "yarn workspace @photon/api db:seed",
        "db:truncate": "yarn workspace @photon/api db:truncate",
        "build": "run-s build:lerna build:db",
        "build:lerna": "lerna run build",
        "build:db": "run-s start:docker db:up",
        "test": "NODE_ENV=test start-server-and-test 'yarn start:app' http://0.0.0.0:3030 'yarn test:all'",
        "test:all": "run-s test:api test:e2e",
        "test:api": "NODE_ENV=test jest -i",
        "test:e2e": "run-s playwright:*",
        "playwright:install": "npx playwright install",
        "playwright:test": "NODE_ENV=test npx playwright test"
    },
    "dependencies": {
        "dotenv": "^16.0.3",
        "graphql": "^16.6.0",
        "typescript": "^4.7.4"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^12.2.3",
        "@playwright/test": "^1.29.2",
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^13.4.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/jest": "^29.2.5",
        "@typescript-eslint/eslint-plugin": "^5.29.0",
        "@typescript-eslint/parser": "^5.29.0",
        "eslint": "^8.20.0",
        "eslint-plugin-react": "^7.30.1",
        "jest": "^29.3.1",
        "lerna": "^6.1.0",
        "npm-run-all": "^4.1.5",
        "start-server-and-test": "^1.15.2",
        "ts-jest": "^29.0.3",
        "ts-node": "^10.9.1"
    }
}
