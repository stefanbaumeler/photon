{
    "name": "photon",
    "private": true,
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": "^16.12.0"
    },
    "engineStrict": true,
    "scripts": {
        "dev": "NODE_ENV=development run-s start:docker watch",
        "prod:api": "run-s start:docker watch:api",
        "watch": "run-p watch:*",
        "watch:api": "yarn workspace @photon/api watch",
        "watch:app": "yarn workspace @photon/app watch",
        "start": "run-p start:api start:app",
        "start:api": "yarn workspace @photon/api start",
        "start:app": "yarn workspace @photon/app start",
        "start:docker": "docker-compose up -d db",
        "db:up": "yarn workspace @photon/api db:up",
        "db:down": "yarn workspace @photon/api db:down",
        "db:seed": "yarn workspace @photon/api db:seed",
        "db:truncate": "yarn workspace @photon/api db:truncate",
        "test": "NODE_ENV=test run-s test:setup test:run",
        "test:open": "NODE_ENV=test run-s test:setup test:run:open",
        "test:setup": "run-s start:docker db:up",
        "test:run": "run-p watch cy",
        "test:run:open": "run-p watch cy:open",
        "build": "run-p build:*",
        "build:app": "yarn workspace @photon/app build:static",
        "build:api": "yarn workspace @photon/api build",
        "cy": "npx cypress run --e2e -b 'chrome'",
        "cy:open": "npx cypress open --e2e -b 'chrome:canary'"
    },
    "dependencies": {
        "dotenv": "^16.0.3",
        "graphql": "^16.6.0",
        "typescript": "^4.7.4"
    },
    "devDependencies": {
        "cypress": "10.11.0",
        "cypress-dotenv": "^2.0.0",
        "cypress-recurse": "^1.23.0",
        "eslint-plugin-cypress": "^2.12.1",
        "lerna": "^6.1.0",
        "npm-run-all": "^4.1.5",
        "start-server-and-test": "^1.14.0",
        "@next/eslint-plugin-next": "^12.2.3",
        "@typescript-eslint/eslint-plugin": "^5.29.0",
        "@typescript-eslint/parser": "^5.29.0",
        "eslint": "^8.20.0",
        "eslint-plugin-react": "^7.30.1"
    }
}
