{
    "name": "photon",
    "private": true,
    "version": "1.0.0",
    "main": "index.js",
    "workspaces": [
        "web",
        "api",
        "app",
        "packages/*"
    ],
    "engines": {
        "node": "^18.12.1"
    },
    "engineStrict": true,
    "scripts": {
        "dev": "NODE_ENV=test run-s start:docker watch",
        "prod:api": "run-s start:docker watch:api",
        "watch": "run-p watch:*",
        "watch:api": "nx run @photon/api:watch",
        "watch:web": "nx run @photon/web:watch",
        "watch:resources": "run-p resources:*",
        "schema": "run-p schema:*",
        "schema:generate": "graphql-codegen -c graphql.ts -w",
        "schema:compile": "nx run @photon/schema:build",
        "resources:web": "nx run @photon/web:generate && nx watch --projects=@photon/resources -- nx run @photon/web:generate",
        "resources:app": "nx run @photon/app:generate && nx watch --projects=@photon/resources -- nx run @photon/app:generate",
        "start": "run-p start:api start:web",
        "start:api": "nx run @photon/api:start",
        "start:web": "nx run @photon/web:start",
        "start:docker": "docker-compose up -d db search",
        "db:up": "nx run @photon/api:db:up",
        "db:down": "nx run @photon/api:db:down",
        "search:setup": "nx run @photon/api:search:setup",
        "build": "run-s build:packages build:db",
        "build:packages": "nx run-many -t build",
        "build:db": "run-s start:docker db:up",
        "test": "NODE_ENV=test run-s start:docker seed-and-test",
        "test:watch": "run-p watch:api watch:web",
        "test:all": "run-s test:api test:web",
        "test:web": "nx run @photon/web:test",
        "test:api": "jest -i",
        "seed-and-test": "start-server-and-test test:watch 11011 test:all"
    },
    "dependencies": {
        "@graphql-codegen/cli": "^5.0.0",
        "@types/supertest": "^2.0.16",
        "dotenv": "^16.3.1",
        "graphql": "^16.8.1",
        "typescript": "^5.2.2"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^12.2.3",
        "@testing-library/jest-dom": "^5.16.5",
        "@types/jest": "^29.2.5",
        "@typescript-eslint/eslint-plugin": "^6.9.0",
        "@typescript-eslint/parser": "^6.9.0",
        "eslint": "^8.20.0",
        "eslint-plugin-react": "^7.30.1",
        "jest": "^29.3.1",
        "npm-run-all": "^4.1.5",
        "nx": "16.2.2",
        "nx-cloud": "latest",
        "start-server-and-test": "^1.15.2",
        "supertest": "^6.3.3",
        "ts-jest": "^29.0.3",
        "ts-node": "^10.9.1"
    }
}
