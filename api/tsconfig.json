{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "sourceMap": true,
        "isolatedModules": true,
        "noEmitOnError": false,
        "incremental": true
    },
    "include": ["**/*.ts"],
    "exclude": [
        "__tests__",
        "./dist"
    ]
}
