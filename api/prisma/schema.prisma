generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl"]
  previewFeatures = ["postgresqlExtensions", "fullTextSearch", "fullTextIndex"]
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider   = "postgresql"
  url        = env("DB_URL")
  extensions = [postgis]
}

model Album {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateCreated  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  title        String?  @db.VarChar(100)
  description  String?
  idCover      String?  @map("id_cover") @db.Uuid
  idOwner      String?  @map("id_owner") @db.Uuid
  cover        Medium?  @relation("album_cover", fields: [idCover], references: [id], onUpdate: NoAction, map: "album_cover_foreign")
  owner        User?    @relation(fields: [idOwner], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "album_owner_foreign")
  media        Medium[]
}

model Medium {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hash               String?   @db.VarChar(255)
  dateCreated        DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified       DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  dateModifiedStatus DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified_status") @db.Timestamptz(6)
  dateTaken          DateTime? @map("date_taken") @db.Timestamptz(6)
  filenameDisk       String    @map("filename_disk") @db.VarChar(100)
  filenameDownload   String?   @map("filename_download") @db.VarChar(100)
  title              String?   @db.VarChar(100)
  description        String?
  location           Float[]
  status             String?   @default("all")
  mimetype           String?   @db.VarChar(255)
  /// [Meta]
  meta               Json?     @db.Json
  idOwner            String?   @map("id_owner") @db.Uuid
  owner              User?     @relation("medium_owner", fields: [idOwner], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medium_owner_foreign")
  idUploader         String?   @map("id_uploader") @db.Uuid
  uploader           User?     @relation("medium_uploader", fields: [idUploader], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "medium_uploader_foreign")
  albums             Album[]
  favoredBy          User[]
  country            String?   @default("")
  region             String?   @default("")
  place              String?   @default("")
  address            String?   @default("")
  tags               Tag[]
  coverOfAlbums      Album[]   @relation("album_cover")

  @@unique(hash)
}

model Tag {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label  String
  idUser String   @map("id_user") @db.Uuid
  user   User     @relation(fields: [idUser], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tag_id_user_foreign")
  media  Medium[]
  source String   @default("generated")

  @@unique([idUser, label])
}

model Device {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateCreated  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  users        User[]
  name         String
  type         String
}

model User {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dateCreated                      DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("date_created") @db.Timestamptz(6)
  dateModified                     DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("date_modified") @db.Timestamptz(6)
  mail                             String    @db.VarChar(255)
  password                         String    @db.VarChar(255)
  firstName                        String    @map("first_name") @db.VarChar(255)
  lastName                         String    @map("last_name") @db.VarChar(255)
  albums                           Album[]
  media                            Medium[]  @relation("medium_owner")
  uploadedMedia                    Medium[]  @relation("medium_uploader")
  devices                          Device[]
  favorites                        Medium[]
  language                         String
  createdTags                      Tag[]
  passwordResetToken               String?   @default("") @map("password_reset_token")
  datePasswordResetTokenExpiration DateTime? @map("date_password_reset_token_expiration")
  signUpToken                      String?   @default("") @map("sign_up_token")
}
