{
    "name": "@photon/api",
    "version": "1.0.0",
    "main": "index.ts",
    "license": "MIT",
    "scripts": {
        "build": "tsc -b ./tsconfig.json && copyfiles .env* dist",
        "watch": "run-p -l watch:*",
        "watch:api": "nest start --watch",
        "db:up": "run-s db:drop db:create db:migrate db:generate \"db:seed dev\"",
        "db:drop": "ts-node src/database/teardown.ts",
        "db:create": "ts-node src/database/setup.ts",
        "db:migrate": "prisma migrate dev",
        "db:generate": "prisma generate",
        "db:reset": "prisma migrate reset",
        "db:seed": "prisma db seed",
        "start": "node dist",
        "test": "NODE_ENV=test jest"
    },
    "dependencies": {
        "@apollo/server": "^4.3.0",
        "@apollographql/graphql-playground-html": "^1.6.29",
        "@ffmpeg/core": "^0.11.0",
        "@ffmpeg/ffmpeg": "^0.11.6",
        "@google-cloud/translate": "^7.2.1",
        "@mapbox/mapbox-sdk": "^0.15.0",
        "@nestjs/apollo": "^12.0.9",
        "@nestjs/common": "^10.2.7",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.2.7",
        "@nestjs/graphql": "^12.0.9",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.2",
        "@nestjs/platform-express": "^10.2.7",
        "@photon/cv": "*",
        "@photon/schema": "*",
        "@photon/storage": "*",
        "@prisma/client": "^5.10.2",
        "@types/passport-jwt": "^3.0.13",
        "adm-zip": "^0.5.10",
        "argon2": "^0.30.2",
        "backo2": "^1.0.2",
        "class-validator": "^0.14.0",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.3.1",
        "exifreader": "^4.12.0",
        "express": "^4.18.1",
        "graphql": "*",
        "graphql-date-scalars": "^0.2.0",
        "graphql-tag": "^2.12.6",
        "graphql-upload-minimal": "^1.5.4",
        "iterall": "^1.3.0",
        "jsonwebtoken": "^9.0.0",
        "lodash.omit": "^4.5.0",
        "mediainfo.js": "^0.1.8",
        "mime-types": "^2.1.35",
        "nestjs-cls": "^3.6.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.7.3",
        "prisma": "^5.10.2",
        "reflect-metadata": "^0.1.13",
        "sharp": "^0.33.2",
        "ts-node": "^10.9.1",
        "typesense": "^1.4.4",
        "yauzl": "^2.10.0",
        "yazl": "^2.5.1"
    },
    "prisma": {
        "seed": "ts-node ./prisma/index.ts"
    },
    "devDependencies": {
        "@graphql-codegen/add": "^5.0.0",
        "@graphql-codegen/cli": "^5.0.0",
        "@graphql-codegen/typescript-react-apollo": "^4.1.0",
        "@graphql-codegen/typescript-resolvers": "^4.0.1",
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/adm-zip": "^0.5.0",
        "@types/cookie-parser": "^1.4.3",
        "@types/cors": "^2.8.13",
