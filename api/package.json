        "@types/mapbox__mapbox-sdk": "^0.13.4",
        "@types/mime-types": "^2.1.1",
        "@types/multer": "^1.4.7",
        "@types/node": "^18.6.3",
        "@types/sharp": "^0.31.1",
        "@types/yauzl": "^2.10.0",
        "@types/yazl": "^2.4.2",
        "copyfiles": "^2.4.1",
        "jest": "^29.3.1",
        "jest-environment-jsdom": "^29.3.1",
        "npm-run-all": "^4.1.5",
        "prisma-json-types-generator": "^3.0.4",
        "ts-jest": "^29.0.3",
        "ts-node-dev": "^2.0.0"
    }
