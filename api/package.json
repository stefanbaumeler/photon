{
    "name": "@photon/api",
    "version": "1.0.0",
    "main": "index.ts",
    "license": "MIT",
    "scripts": {
        "build": "tsc -b ./tsconfig.json && copyfiles .env* dist",
        "watch": "run-p -l watch:*",
        "watch:api": "ts-node-dev index.ts",
        "db:up": "run-s db:down db:setup db:generate \"seed dev\"",
        "db:down": "ts-node src/database/teardown.ts",
        "db:setup": "ts-node src/database/setup.ts",
        "db:generate": "prisma generate",
        "start": "node dist",
        "test": "run-s search:setup jest",
        "search:setup": "ts-node src/search/setup.ts",
        "search:sync": "ts-node src/search/sync.ts",
        "postinstall": "npx prisma generate",
        "seed": "ts-node setups"
    },
    "dependencies": {
        "@apollo/server": "^4.3.0",
        "@ffmpeg/core": "^0.11.0",
        "@ffmpeg/ffmpeg": "^0.11.6",
        "@mapbox/mapbox-sdk": "^0.15.0",
        "@photon/cv": "*",
        "@photon/schema": "*",
        "@photon/storage": "*",
        "@prisma/client": "^4.10.1",
        "@types/exif-reader": "^1.0.0",
        "adm-zip": "^0.5.10",
        "argon2": "^0.30.2",
        "cookie-parser": "^1.4.6",
        "dotenv": "^16.0.3",
        "exifreader": "^4.5.1",
        "express": "^4.18.1",
        "graphql": "*",
        "graphql-date-scalars": "^0.2.0",
        "graphql-tag": "^2.12.6",
        "graphql-upload-minimal": "^1.5.4",
        "jsonwebtoken": "^9.0.0",
        "mediainfo.js": "^0.1.8",
        "mime-types": "^2.1.35",
        "pg": "^8.7.3",
        "prisma": "^4.10.1",
        "sharp": "^0.31.3",
        "ts-node": "^10.9.1",
        "typesense": "^1.4.4",
        "yauzl": "^2.10.0",
        "yazl": "^2.5.1"
    },
    "devDependencies": {
        "@graphql-codegen/add": "^3.2.3",
        "@graphql-codegen/cli": "^2.6.2",
        "@graphql-codegen/typescript-react-apollo": "^3.2.16",
        "@graphql-codegen/typescript-resolvers": "^2.6.6",
        "@types/adm-zip": "^0.5.0",
        "@types/cookie-parser": "^1.4.3",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.13",
        "@types/ffmpeg": "^1.0.4",
        "@types/jest": "^29.2.5",
        "@types/jsonwebtoken": "^9.0.1",
        "@types/mapbox__mapbox-sdk": "^0.13.4",
        "@types/mime-types": "^2.1.1",
        "@types/multer": "^1.4.7",
        "@types/node": "^18.6.3",
        "@types/sharp": "^0.31.1",
        "@types/yauzl": "^2.10.0",
        "@types/yazl": "^2.4.2",
        "copyfiles": "^2.4.1",
        "jest": "^29.3.1",
        "jest-environment-jsdom": "^29.3.1",
        "npm-run-all": "^4.1.5",
        "ts-jest": "^29.0.3",
        "ts-node-dev": "^2.0.0",
        "typescript": "^4.7.4"
    }
}
